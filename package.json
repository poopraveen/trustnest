{
  "name": "trustnest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev -p 3000",
    "dev:fresh": "npm run clean && next dev -p 3000",
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://build:build@localhost/build} prisma generate && next build",
    "vercel-build": "DATABASE_URL=${DATABASE_URL:-postgresql://build:build@localhost/build} prisma generate && ([ -n \"$DATABASE_URL\" ] && prisma db push --accept-data-loss || echo 'No DATABASE_URL — skipping db push') && next build",
    "build:fresh": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "tenant": "node scripts/switch-tenant.mjs",
    "tenant:list": "node scripts/switch-tenant.mjs list",
    "admin:create": "tsx scripts/create-admin.ts",
    "ward:gen": "node scripts/gen-ward-election-data.mjs all",
    "ward:gen:veppampattu": "node scripts/gen-ward-election-data.mjs veppampattu",
    "ward:gen:perumalpattu": "node scripts/gen-ward-election-data.mjs perumalpattu",
    "ward:import:perumalpattu": "node scripts/import-perumalpattu-voters.mjs",
    "tenant:vercel": "node scripts/export-vercel-env.mjs",
    "brochure:hbl": "python scripts/generate_pdf_brochure.py",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
