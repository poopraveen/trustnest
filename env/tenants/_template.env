# Copy to env/tenants/your-company.env and run: npm run tenant -- your-company
# Secrets (DATABASE_URL, NEXTAUTH_SECRET, GOOGLE_*) stay in .env — this file only sets branding + URLs.

NEXT_PUBLIC_BRAND_NAME="Your Company Name"
NEXT_PUBLIC_BRAND_WORDMARK_PREFIX="Your"
NEXT_PUBLIC_BRAND_WORDMARK_ACCENT="Brand"
NEXT_PUBLIC_BRAND_TAGLINE="Your tagline here"
NEXT_PUBLIC_BRAND_FOOTER_DESCRIPTION="Short footer description for your company."
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="support@yourcompany.com"
NEXT_PUBLIC_BRAND_PHONE="1800-000-0000"
NEXT_PUBLIC_BRAND_OFFICE_ADDRESS="Your office address"
NEXT_PUBLIC_BRAND_DOMAIN="https://yourcompany.com"
NEXT_PUBLIC_BRAND_META_DESCRIPTION="SEO description for your deployment."

# Per-tenant site URL (local). Production: set in Vercel project env.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
