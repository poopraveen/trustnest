# ─────────────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE  (required)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXTAUTH_SECRET="generate-a-32-char-random-string"
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI — for AI property descriptions & recommendations
OPENAI_API_KEY=""

# AWS S3 — for property image uploads
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="your-bucket-name"

# ─────────────────────────────────────────────────────────────────────────────
# WHITE-LABEL BRANDING  (all optional — defaults shown)
# Change these to rebrand for any real-estate company without touching code.
# ─────────────────────────────────────────────────────────────────────────────

# Full product name used in page titles, emails, copyright line
NEXT_PUBLIC_BRAND_NAME="PooPrav TrustNest"

# Logo wordmark split: prefix is normal colour, accent is orange
NEXT_PUBLIC_BRAND_WORDMARK_PREFIX="PooPrav Trust"
NEXT_PUBLIC_BRAND_WORDMARK_ACCENT="Nest"

# Hero tagline (shown in header and meta tags)
NEXT_PUBLIC_BRAND_TAGLINE="India's Most Trusted Real Estate Platform"

# Footer paragraph (2-3 sentences)
NEXT_PUBLIC_BRAND_FOOTER_DESCRIPTION="India's most trusted real estate platform. Find verified properties for sale and rent across 50+ cities with AI-powered recommendations."

# Contact
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="support@yourdomain.in"
NEXT_PUBLIC_BRAND_PHONE="1800-123-4567"
NEXT_PUBLIC_BRAND_OFFICE_ADDRESS="Corporate Office, Anna Salai, Chennai 600002"

# Canonical domain
NEXT_PUBLIC_BRAND_DOMAIN="https://yourdomain.in"

# Social media links (set to empty string "" to hide the icon)
NEXT_PUBLIC_BRAND_FACEBOOK="https://facebook.com/yourpage"
NEXT_PUBLIC_BRAND_TWITTER="https://twitter.com/yourhandle"
NEXT_PUBLIC_BRAND_INSTAGRAM="https://instagram.com/yourhandle"
NEXT_PUBLIC_BRAND_LINKEDIN="https://linkedin.com/company/yourcompany"
NEXT_PUBLIC_BRAND_YOUTUBE=""

# SEO meta description (auto-generated from name if not set)
NEXT_PUBLIC_BRAND_META_DESCRIPTION=""

# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM NOTIFICATIONS  (optional — grievance ticket alerts)
# 1. Create a bot at https://t.me/BotFather and copy the token
# 2. Send any message to your bot, then call:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Copy the "id" field from the "chat" object
# ─────────────────────────────────────────────────────────────────────────────
# Legal-tech PDF generation API (payrollsystem-2w0h.onrender.com)
LEGAL_TECH_API_TOKEN=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# SIGNFLOW — e-signature envelopes (grievance acknowledgment PDF signing)
# Get key at: https://signflow-drab.vercel.app/settings/api-keys  (format: sfk_…)
# ─────────────────────────────────────────────────────────────────────────────
SIGNFLOW_API_KEY=""

# Footer city list (comma-separated, max 8 cities)
# Example for Tamil Nadu: Chennai,Coimbatore,Madurai,Trichy,Salem,Vellore,Tirunelveli,Erode
NEXT_PUBLIC_BRAND_FOOTER_CITIES=""
